---
// ProcessCycle.astro
// Circular 7-step administration cycle matching Slide 2 reference.
// Desktop: SVG diagram. Mobile: linear ordered list fallback.
// SVG colors use CSS custom properties — they track @theme tokens automatically.

const steps = [
  { label: 'Captar y filtrar clientes' },
  { label: 'Gestión contractual' },
  { label: 'Comunicación con inquilinos' },
  { label: 'Cobranzas' },
  { label: 'Mantenimientos y reparaciones' },
  { label: 'Reportar resultados' },
  { label: 'Gestionar fin del contrato' },
];

const CENTER_X = 350;
const CENTER_Y = 200;
const NODE_R = 124;
const BADGE_R = 26;
const LABEL_GAP = 8;
const SLICE = 360 / steps.length;

const nodes = steps.map((step, i) => {
  const deg = -90 + i * SLICE;
  const rad = (deg * Math.PI) / 180;
  const x = CENTER_X + NODE_R * Math.cos(rad);
  const y = CENTER_Y + NODE_R * Math.sin(rad);

  // Left/right bias: labels sit horizontally NEXT to their badge
  const onRight = x > CENTER_X + 0.5;
  const onLeft = x < CENTER_X - 0.5;
  const isTop = !onRight && !onLeft;

  let labelAnchor: 'start' | 'middle' | 'end';
  let lx: number;
  let ly: number;

  if (isTop) {
    labelAnchor = 'middle';
    lx = x;
    ly = y - BADGE_R - LABEL_GAP;
  } else if (onRight) {
    labelAnchor = 'start';
    lx = x + BADGE_R + LABEL_GAP;
    ly = y;
  } else {
    labelAnchor = 'end';
    lx = x - BADGE_R - LABEL_GAP;
    ly = y;
  }

  return {
    ...step,
    n: i + 1,
    x,
    y,
    lx,
    ly,
    labelAnchor,
  };
});
---

{/* Mobile fallback */}
<ol class="mx-auto max-w-md space-y-3 md:hidden">
  {nodes.map((node) => (
    <li class="flex items-center gap-3 rounded-lg border border-neutral-200 bg-white p-3">
      <span
        class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-accent-500 text-sm font-semibold text-white"
      >
        {node.n}
      </span>
      <span class="text-sm font-semibold text-primary-600">{node.label}</span>
    </li>
  ))}
</ol>

{/* Desktop circular SVG — colors via CSS variables, not hardcoded hex */}
<div class="hidden px-4 md:block cycle-ring cycle-spoke cycle-ink cycle-muted cycle-accent cycle-white cycle-sans cycle-display">
  <svg
    viewBox="0 0 700 400"
    role="img"
    aria-label="Ciclo de administración ANCORA: Captar y filtrar clientes, Gestión contractual, Comunicación con inquilinos, Cobranzas, Mantenimientos y reparaciones, Reportar resultados, Gestionar fin del contrato."
    class="mx-auto w-full max-w-3xl"
    style="overflow: visible;"
  >
    <circle cx={CENTER_X} cy={CENTER_Y} r={NODE_R} fill="none" stroke="var(--cycle-ring)" stroke-width="2" />

    {nodes.map((node) => (
      <line x1={CENTER_X} y1={CENTER_Y} x2={node.x} y2={node.y} stroke="var(--cycle-spoke)" stroke-width="2" />
    ))}

    <circle cx={CENTER_X} cy={CENTER_Y} r="60" fill="var(--cycle-white)" stroke="var(--cycle-ink)" stroke-width="2" />
    <text
      x={CENTER_X}
      y={CENTER_Y - 6}
      text-anchor="middle"
      dominant-baseline="central"
      font-family="var(--cycle-display)"
      font-size="24"
      font-weight="700"
      letter-spacing="0.06em"
      fill="var(--cycle-ink)"
    >
      ANCORA
    </text>

    {nodes.map((node) => (
      <g>
        <circle cx={node.x} cy={node.y} r={BADGE_R} fill="var(--cycle-accent)" />
        <text
          x={node.x}
          y={node.y}
          text-anchor="middle"
          dominant-baseline="central"
          font-family="var(--cycle-sans)"
          font-size="16"
          font-weight="700"
          fill="var(--cycle-white)"
        >
          {node.n}
        </text>
        <text
          x={node.lx}
          y={node.ly}
          text-anchor={node.labelAnchor}
          dominant-baseline="central"
          font-family="var(--cycle-sans)"
          font-size="12"
          font-weight="600"
          fill="var(--cycle-ink)"
        >
          {node.label}
        </text>
      </g>
    ))}
  </svg>
</div>

<style>
  .cycle-ring { --cycle-ring: var(--color-neutral-200); }
  .cycle-spoke { --cycle-spoke: var(--color-neutral-100); }
  .cycle-ink { --cycle-ink: var(--color-primary-600); }
  .cycle-muted { --cycle-muted: var(--color-neutral-500); }
  .cycle-accent { --cycle-accent: var(--color-accent-500); }
  .cycle-white { --cycle-white: #ffffff; }
  .cycle-sans { --cycle-sans: "Inter", system-ui, -apple-system, sans-serif; }
  .cycle-display { --cycle-display: "Cormorant Garamond", "Georgia", "Times New Roman", serif; }
</style>
