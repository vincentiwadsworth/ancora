---
import { Icon } from 'astro-icon/components';
import { testimonials } from '../data/testimonials';
---

<div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
  {testimonials.map((t) => (
    <article class="rounded-lg border border-neutral-200 bg-white p-6 transition duration-300 hover:-translate-y-1 hover:shadow-lg card-accent">
      <div class="text-accent-500" aria-hidden="true">
        <Icon name="ph:quotes" class="size-10" />
      </div>
      <blockquote class="mt-4 text-base text-neutral-700">
        &ldquo;{t.quote}&rdquo;
      </blockquote>
      <footer class="mt-4">
        <p class="font-semibold text-primary-600">{t.name}</p>
        <p class="text-sm text-neutral-500">{t.role}</p>
      </footer>
    </article>
  ))}
</div>
