---
import { Icon } from 'astro-icon/components';
import ComparisonVisual from '../components/ComparisonVisual.astro';
import FaqAccordion from '../components/FaqAccordion.astro';

import PainCard from '../components/PainCard.astro';
import ProcessCycle from '../components/ProcessCycle.astro';
import Section from '../components/Section.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Testimonials from '../components/Testimonials.astro';
import TrustStrip from '../components/TrustStrip.astro';
import { site, whatsappLink } from '../config/site';
import { pains } from '../data/pains';
import { services } from '../data/services';
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.brandName,
  url: 'https://ancora.com.bo',
  logo: 'https://ancora.com.bo/favicon.svg',
  description: site.tagline,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address,
    addressCountry: 'BO',
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      telephone: site.phone,
      contactType: 'customer service',
      areaServed: 'BO',
      availableLanguage: ['Spanish'],
    },
  ],
  email: site.email,
};

const ctaAsesoria = whatsappLink('solicitarAsesoria');

const sectionHeading = 'uppercase tracking-wider';

// FAQ copy from Slide 4 reference. Answers are concise placeholders.
const faqItems = [
  {
    q: '¿Qué pasa si el inquilino se atrasa?',
    a: 'Gestionamos la cobranza desde el primer día de atraso y te mantenemos informado en cada paso.',
  },
  {
    q: '¿Qué servicios ofrecen?',
    a: 'Búsqueda de inquilinos, asesoramiento legal, búsqueda y verificación, gestión de cobranza, mantenimiento, reportes mensuales, conciliaciones y gestión de contratos.',
  },
  {
    q: '¿Quién paga los mantenimientos?',
    a: 'Coordinamos los mantenimientos con proveedores confiables y gestionamos el pago según lo acordado en el contrato.',
  },
  {
    q: '¿Cómo seleccionan a los inquilinos?',
    a: 'Verificamos ingresos, referencias y documentación antes de recomendar un inquilino.',
  },
  {
    q: '¿Cada cuánto recibo mi dinero?',
    a: 'Recibís la transferencia mensual junto con un reporte detallado de ingresos y egresos.',
  },
  {
    q: '¿Trabajan con casas y departamentos?',
    a: 'Sí, administramos propiedades residenciales en alquiler, ya sean casas o departamentos.',
  },
  {
    q: '¿Cuál es la tarifa?',
    a: 'Cobramos el 7% del canon mensual. Por ejemplo, en un alquiler de Bs. 3.000, nuestro honorario es de Bs. 210 y recibís Bs. 2.790 netos.',
  },
];
---

<BaseLayout page="home" jsonLd={jsonLd}>
  {/* Hero — full-width background image, text left-aligned like reference */}
  <section
    id="hero"
    class="scroll-reveal relative flex min-h-[640px] items-end bg-primary-600 text-white md:items-center"
  >
    <div class="absolute inset-0">
      <img
        src="/images/hero-bg.webp"
        alt=""
        class="hero-focus-img h-full w-full object-cover"
        width="1440"
        height="800"
        fetchpriority="high"
      />
      <div class="overlay-gradient"></div>
      {/* Mobile-only scrim: hero plant leaves blow out the white text below md */}
      <div class="absolute inset-0 bg-primary-600/55 md:hidden" aria-hidden="true"></div>
    </div>

    <div class="relative mx-auto w-full max-w-6xl px-4 pb-8 pt-24 sm:px-6 md:py-24 lg:px-8">
      <div class="max-w-2xl">
        <h1 class="stagger-1 font-display text-4xl font-bold leading-tight md:leading-tight sm:text-6xl lg:text-7xl">
          <span class="whitespace-nowrap">Tu propiedad genera renta.</span>
          <span class="block text-accent-500">Vos solo cobrás.</span>
        </h1>
        <p class="stagger-2 mt-6 max-w-xl text-lg text-neutral-100 sm:text-xl">
          Administramos íntegramente tu inmueble para que generes ingresos sin ocuparte del día a día.
        </p>
        <div class="stagger-3 mt-8">
          <a
            href={ctaAsesoria}
            target="_blank"
            rel="noopener noreferrer"
            onclick="window.umami?.track('cta-hero')"
            class="inline-flex items-center justify-center gap-2 rounded-md bg-accent-500 px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-accent-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500"
          >
            <Icon name="ph:whatsapp-logo" class="text-white" aria-hidden="true" />
            Solicitar asesoría gratuita
          </a>
        </div>
      </div>
    </div>
  </section>

  <TrustStrip />

  {/* Dolores */}
  <Section
    id="dolores"
    background="muted"
    containerClass="scroll-reveal"
  >
    <div class="max-w-3xl">
      <h2 class:list={['font-display text-3xl font-semibold leading-tight sm:text-4xl text-primary-600', sectionHeading]}>
        ¿Compraste un inmueble para generar ingresos o para administrar problemas?
      </h2>
      <p class="mt-4 text-lg text-neutral-600">
        Muchos propietarios terminan ocupándose de tareas que les quitan tiempo, dinero y tranquilidad.
      </p>
    </div>
    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-5">
      {pains.map((pain) => <PainCard pain={pain} />)}
    </div>
  </Section>

  {/* Cómo funciona */}
  <Section
    id="como-funciona"
    heading="¿Cómo funciona?"
    headingClass={sectionHeading}
    intro="Nos ocupamos de todo el proceso, de principio a fin."
    background="default"
    containerClass="scroll-reveal"
  >
    <ProcessCycle />
  </Section>

  {/* Servicios */}
  <Section
    id="servicios"
    background="muted"
    containerClass="scroll-reveal"
  >
    <div class="max-w-3xl">
      <h2 class:list={['font-display text-3xl font-semibold leading-tight sm:text-4xl text-primary-600', sectionHeading]}>
        SERVICIOS
      </h2>
      <p class="mt-2 text-lg font-semibold text-primary-600">¿QUÉ INCLUYE NUESTRO SERVICIO?</p>
      <p class="mt-4 text-lg text-neutral-600">
        Administración integral para proteger tu patrimonio y maximizar tu rentabilidad.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {services.map((service) => (
        <ServiceCard
          title={service.title}
          description={service.description}
          icon={service.icon}
        />
      ))}
    </div>

  </Section>

  {/* Diferenciación */}
  <Section
    id="diferenciacion"
    heading="La Diferencia entre Alquilar y Administrar"
    intro="Muchas inmobiliarias terminan su trabajo cuando se firma el contrato. ANCORA continúa administrando durante toda la relación contractual."
    background="default"
    containerClass="scroll-reveal"
  >
    <ComparisonVisual />
  </Section>

  {/* Testimonios */}
  <Section
    id="testimonios"
    heading="TESTIMONIOS"
    headingClass={sectionHeading}
    intro="Lo que dicen los propietarios que confían en ANCORA."
    background="default"
    containerClass="scroll-reveal"
  >
    <Testimonials />
  </Section>

  {/* FAQ */}
  <Section
    id="preguntas"
    background="muted"
    containerClass="scroll-reveal"
  >
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-x-16 lg:gap-y-8 items-start">
      {/* Cabecera: Izquierda arriba en desktop, arriba en mobile */}
      <div class="lg:col-span-5">
        <h2 class:list={['font-display text-3xl font-semibold leading-tight sm:text-4xl text-primary-600', sectionHeading]}>
          PREGUNTAS FRECUENTES
        </h2>
        <p class="mt-4 text-lg text-neutral-600">
          Respuestas a las dudas más comunes de los propietarios.
        </p>
      </div>

      {/* Acordeón: Derecha en desktop (ocupando dos filas), medio en mobile */}
      <div class="lg:col-span-7 lg:row-span-2">
        <FaqAccordion items={faqItems} />
      </div>

      {/* Tarjeta de soporte: Izquierda abajo en desktop, abajo en mobile */}
      <div class="lg:col-span-5">
        <div class="rounded-lg border border-neutral-200 bg-white p-6 shadow-xs">
          <h3 class="font-semibold text-primary-600 text-lg">¿Tenés otra consulta?</h3>
          <p class="mt-2 text-sm text-neutral-600 leading-relaxed">
            Si tenés dudas específicas sobre tu propiedad, escribinos directamente por WhatsApp. Estamos para ayudarte.
          </p>
          <a
            href={whatsappLink('general')}
            target="_blank"
            rel="noopener noreferrer"
            onclick="window.umami?.track('cta-faq-help')"
            class="mt-4 inline-flex items-center gap-2 rounded-md bg-primary-600 px-4 py-2.5 text-sm font-semibold text-white transition-colors hover:bg-primary-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 cursor-pointer"
          >
            <Icon name="ph:whatsapp-logo" class="text-white text-base" aria-hidden="true" />
            Hablar con un asesor
          </a>
        </div>
      </div>
    </div>
  </Section>

  {/* CTA final */}
  <section
    id="cta-final"
    class="scroll-reveal relative flex min-h-[480px] items-end bg-primary-600 text-white md:items-center"
  >
    <div class="absolute inset-0">
      <img
        src="/images/cta-building.webp"
        alt=""
        class="h-full w-full object-cover"
        width="1440"
        height="800"
        loading="lazy"
      />
      <div class="overlay-gradient"></div>
    </div>

    <div class="relative mx-auto w-full max-w-6xl px-4 pb-12 pt-28 sm:px-6 md:py-24 lg:px-8">
      <div class="max-w-2xl">
        <h2 class="font-display text-3xl font-semibold text-white sm:text-4xl">
          Tu patrimonio merece administración profesional.
        </h2>
        <p class="mt-4 max-w-xl text-lg text-neutral-200">
          Nos encargamos de todo para que vos solo disfrutes los resultados.
        </p>
        <div class="mt-8 flex flex-col items-start gap-3 sm:flex-row">
          <a
            href={ctaAsesoria}
            target="_blank"
            rel="noopener noreferrer"
            onclick="window.umami?.track('cta-final')"
            class="inline-flex items-center justify-center gap-2 rounded-md bg-accent-500 px-6 py-3 text-base font-semibold text-white transition-colors hover:bg-accent-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-500"
          >
            <Icon name="ph:calendar-check" class="text-white" aria-hidden="true" />
            Agendar asesoría gratuita
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
